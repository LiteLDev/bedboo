{
  "name": "@bedboo/bedrock-data",
  "version": "0.0.0",
  "description": "Bedrock data overlays (one per protocol family: 1.26.40, 1.26.45, 1.26.51, 1.26.60) injected into minecraft-data (bedrock_<version>)",
  "license": "LGPL-3.0-only",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteLDev/bedboo.git",
    "directory": "packages/bedrock-data"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-isolation=none --test-timeout=60000 \"test/**/*.test.js\"",
    "generate": "node scripts/fetch-sources.js && node scripts/generate.js",
    "generate:check": "node scripts/fetch-sources.js --all && node scripts/generate.js --check --all"
  },
  "dependencies": {
    "minecraft-data": "3.119.0"
  },
  "devDependencies": {
    "prismarine-nbt": "2.8.0"
  },
  "files": [
    "index.js",
    "install.js",
    "features.js",
    "data",
    "NOTICE.md"
  ]
}
