{
  "name": "bedboo",
  "version": "0.0.0",
  "description": "Minecraft Bedrock Edition bot library with a mineflayer-compatible API (createBot, bot.*, events, plugins, typings) for Bedrock Dedicated Server 1.26.40 – 1.26.60 (BDS 1.26.42.1 – 1.26.63.1)",
  "license": "LGPL-3.0-only",
  "main": "index.js",
  "types": "index.d.ts",
  "homepage": "https://github.com/LiteLDev/bedboo#readme",
  "bugs": {
    "url": "https://github.com/LiteLDev/bedboo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteLDev/bedboo.git",
    "directory": "packages/bedboo"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "bedrock-edition",
    "bds",
    "bedrock-dedicated-server",
    "mineflayer",
    "bot",
    "mcpe",
    "raknet",
    "nethernet",
    "prismarine"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "types",
    "examples",
    "README.md",
    "COPYING",
    "COPYING.LESSER"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none --test-timeout=60000 --require ./test/strict-features.js --require ./test/skip-missing-fixtures.js \"test/unit/**/*.test.js\"",
    "typecheck": "node test/types/check.js"
  },
  "dependencies": {
    "@bedboo/bedrock-data": "workspace:*",
    "bedrock-protocol": "3.61.0",
    "minecraft-data": "3.119.0",
    "mineflayer": "4.39.0",
    "prismarine-block": "1.23.0",
    "prismarine-chat": "1.13.0",
    "prismarine-chunk": "1.41.0",
    "prismarine-entity": "2.6.0",
    "prismarine-item": "1.18.0",
    "prismarine-nbt": "2.8.0",
    "prismarine-physics": "1.11.1",
    "prismarine-recipe": "1.5.0",
    "prismarine-registry": "1.12.0",
    "prismarine-windows": "2.10.0",
    "prismarine-world": "3.7.0",
    "raknet-native": "1.2.3",
    "typed-emitter": "1.4.0",
    "uuid-1345": "1.0.2",
    "vec3": "0.1.10"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "mineflayer-armor-manager": "2.0.1",
    "mineflayer-auto-eat": "5.0.3",
    "mineflayer-collectblock": "1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2",
    "mineflayer-tool": "1.2.0",
    "typescript": "7.0.2"
  }
}
