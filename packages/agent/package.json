{
  "name": "@bedboo/agent",
  "version": "0.0.0",
  "private": true,
  "description": "Scripted (no LLM) survival agent built on mineflayer-bedrock",
  "license": "LGPL-3.0-only",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteLDev/bedboo.git",
    "directory": "packages/agent"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "mocha",
    "test:e2e": "mocha --config .mocharc.e2e.json",
