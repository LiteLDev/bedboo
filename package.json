{
  "version": "0.0.0",
  "private": true,
  "description": "bedboo monorepo: a Minecraft Bedrock Edition bot library with a mineflayer-compatible API",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteLDev/bedboo.git"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "fix": "standard --fix",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm --filter bedboo run typecheck"
  },
  "devDependencies": {
    "bedboo": "workspace:*",
    "standard": "17.1.2"
  },
  "standard": {
    "ignore": [
      "**/*.d.ts",
      "docs/**"
    ]
  }
}
