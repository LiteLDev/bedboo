{
  "name": "bedboo",
  "version": "0.0.0",
  "private": true,
  "description": "mineflayer for Minecraft: Bedrock Edition (Bedrock Dedicated Server)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiteLDev/bedboo.git"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "fix": "standard --fix",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "node scripts/run-e2e.js",
    "typecheck": "pnpm --filter mineflayer-bedrock run typecheck",
    "parity": "node scripts/parity/index.js",
    "bds": "bds"
  },
  "devDependencies": {
    "@bedboo/bds": "workspace:*",
    "@types/node": "24.19.2",
    "mineflayer-bedrock": "workspace:*",
    "mocha": "12.0.3",
    "standard": "17.1.2",
    "typescript": "7.0.2"
  },
  "standard": {
    "env": [
      "mocha"
    ],
    "ignore": [
      "docs/upstream/**",
      "**/*.d.ts"
    ]
  }
}
