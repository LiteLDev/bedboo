+// bedboo patch: Bedrock 1.19.80+ signs are two-sided: the block entity has `FrontText` / `BackText` compounds
+// whose `Text` string holds every line (`\n`-separated); only pre-1.19.80 signs had a top-level `Text`.
+// (upstream read `this.entity.Text`, i.e. the compound itself, and threw on every sign)
 function signBedrock (registry) {
+  const SIDE_DEFAULTS = {
+    IgnoreLighting: () => nbt.byte(0),
+    HideGlowOutline: () => nbt.byte(0),
+    PersistFormatting: () => nbt.byte(1),
+    SignTextColor: () => nbt.int(-16777216),
+    TextOwner: () => nbt.string(''),
+    FilteredText: () => nbt.string('')
+  }
+  const toText = (text) => Array.isArray(text) ? text.map(t => typeof t === 'string' ? t : (t?.toString?.() ?? String(t))).join('\n') : String(text)
+
+  function sideText (entity, side) {
+    const compound = entity?.value?.[side]
+    if (compound?.type === 'compound') return compound.value?.Text?.value ?? ''
+    return undefined
+  }
+
+  function setSide (block, side, text) {
+    if (!block.entity) block.entity = nbt.comp({ id: nbt.string('Sign') })
+    let compound = block.entity.value[side]
+    if (compound?.type !== 'compound') {
+      compound = nbt.comp({})
+      block.entity.value[side] = compound
+    }
+    for (const [key, make] of Object.entries(SIDE_DEFAULTS)) {
+      if (!(key in compound.value)) compound.value[key] = make()
+    }
+    compound.value.Text = nbt.string(toText(text))
+  }
+
   return {
+    /** [front, back] like the Java multi-sided signs (each side: every line joined with '\n') */
     getSignText () {
-      if (!this.entity) return ['']
-      return [this.entity.Text.value]
+      if (!this.entity) return ['', '']
+      const front = sideText(this.entity, 'FrontText') ?? this.entity.value?.Text?.value ?? ''
+      const back = sideText(this.entity, 'BackText') ?? ''
+      return [front, back]
     },
-    setSignText (text) {
-      if (!this.entity) {
-        this.entity = nbt.comp({ id: nbt.string('Sign') })
-      }
-      Object.assign(this.entity.value, {
-        Text: nbt.string(Array.isArray(text) ? text.join('\n') : text)
-      })
+    setSignText (front, back) {
+      if (front !== undefined) setSide(this, 'FrontText', front)
+      if (back !== undefined) setSide(this, 'BackText', back)
     },
