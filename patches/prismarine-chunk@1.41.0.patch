+    if (block) return { stateId: block.stateId, ...block, count: 0 }
+    const placeholder = this.registry.blocksByName.unknown ?? this.registry.blocksByName.air
+    return { stateId: placeholder.defaultState, name: placeholder.name, runtimeId, count: 0 }
+  }
+
+  // network runtime id of a palette entry (inverse of resolveRuntimeEntry)
+  runtimeIdOf (entry) {
+    return entry.runtimeId ?? this.registry.runtimeIdByStateId?.[entry.stateId] ?? entry.stateId
+  }
+
   loadRuntimePalette (storageLayer, stream, paletteSize) {
