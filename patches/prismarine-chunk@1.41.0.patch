+      // Single-block (zero-bit) section: one zigzag runtime id for the whole section (hashes can be negative,
+      // so `readVarInt() >> 1` is not enough). The entry counts all 4096 blocks.
+      this.palette[storageLayer] = [{ ...this.resolveRuntimeEntry(stream.readZigZagVarInt()), count: 4096 }]
