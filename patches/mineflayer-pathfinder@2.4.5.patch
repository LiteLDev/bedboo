diff --git a/lib/bedrock.js b/lib/bedrock.js
new file mode 100644
index 0000000000000000000000000000000000000000..419ccc5f48514488e645e56c3ac7397cd01ec0a2
--- /dev/null
+++ b/lib/bedrock.js
@@ -0,0 +1,64 @@
+// bedboo (mineflayer-bedrock) patch, U15: helpers shared by index.js and lib/movements.js so the pathfinder works on
+// Minecraft: Bedrock Edition (mineflayer-bedrock bots) without changing its behaviour on Java.
+
+/**
+ * Milliseconds to break `block` holding `tool` (upstream: prismarine-block `block.digTime(type, false, false, false,
+ * nbt.simplify(tool.nbt).Enchantments, effects)`).
+ * - Enchantments come from `item.enchants` (prismarine-item: Java `Enchantments` and Bedrock `ench` NBT alike, as
+ *   `{ name, lvl }` — upstream's simplified NBT has `id`, which prismarine-block never matches).
+ * - mineflayer-bedrock bots expose `bot._bedrock.digging.blockDigTime` (Bedrock Haste / Conduit Power / Mining Fatigue
+ *   factors); prismarine-block's own digTime keeps Java's.
+ */
+function digTimeOf (bot, block, tool) {
+  const type = tool ? tool.type : null
+  const enchants = (tool && tool.enchants) || []
+  const effects = (bot.entity && bot.entity.effects) || {}
+  const bedrock = bot._bedrock && bot._bedrock.digging && bot._bedrock.digging.blockDigTime
+  if (typeof bedrock === 'function') return bedrock(block, type, false, false, false, enchants, effects)
+  return block.digTime(type, false, false, false, enchants, effects)
+}
+
+/** registry ids of the blocks named `names` that exist in this registry (Java and Bedrock names differ) */
+function idsOf (registry, names) {
+  const ids = []
+  for (const name of names) {
+    const block = registry.blocksByName[name]
+    if (block) ids.push(block.id)
+  }
+  return ids
+}
+
+/** wooden (hand-openable) doors and fence gates: Java `oak_door` / Bedrock `wooden_door`, `*_fence_gate` / `fence_gate` */
+function isOpenableName (name) {
+  if (name.includes('iron')) return false
+  if (name === 'fence_gate' || name.endsWith('_fence_gate')) return true
+  return (name === 'wooden_door' || name.endsWith('_door')) && !name.endsWith('trapdoor')
+}
+
+/** an open door / gate (Java property `open`, Bedrock `open_bit`) */
+function isOpen (block) {
+  if (!block || typeof block.getProperties !== 'function') return false
+  const props = block.getProperties()
+  return props.open === true || props.open === 'true' || props.open_bit === true || props.open_bit === 1 || props.open_bit === 'true'
+}
+
+/**
+ * Whether a bot crossing `block` along `dir` ({x, z}, one of them 0), centred in it (0.6 wide: 0.2–0.8), clears every
+ * collision box of the block: a door leaf at the edge it walks along does, the leaf across its way does not.
+ */
+function passableAlong (block, dir) {
+  for (const [x0, , z0, x1, , z1] of block.shapes) {
+    if (dir.x !== 0 ? (z1 > 0.2 && z0 < 0.8) : (x1 > 0.2 && x0 < 0.8)) return false
+  }
+  return true
+}
+
+/**
+ * Whether the bot runs on a server-authoritative movement server (Bedrock): moving `bot.entity.position` client side
+ * (fullStop's recentring) is corrected by the server there instead of being accepted like on Java.
+ */
+function serverAuthoritativeMovement (bot) {
+  return !!(bot._bedrock && bot._bedrock.physics)
+}
+
+module.exports = { digTimeOf, idsOf, isOpenableName, isOpen, passableAlong, serverAuthoritativeMovement }
